#!/bin/sh
# apkbuild -- Gradle-free Android APK/AAR builds for Termux and Linux.
#
# /bin/sh exists on Termux and on Linux; re-exec bash because the
# implementation uses arrays. Termux has no /usr/bin/env, so a portable
# shebang is not possible here.
if [ -z "${BASH_VERSION:-}" ]; then
    exec bash "$0" "$@"
fi
#
# See docs/interface.md for the contract and README.md for the why. License:
# GPL-3.0-or-later.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../lib/apkbuild.sh
. "$here/../lib/apkbuild.sh"

command=${1:-}
[ $# -gt 0 ] && shift
case $command in
    ''|-h|--help|help) apkbuild_usage ;;
    version|--version) printf 'apkbuild %s\n' "$APKBUILD_VERSION" ;;
    doctor) apkbuild_cmd_doctor "$@" ;;
    sdk) apkbuild_cmd_sdk "$@" ;;
    compile) apkbuild_cmd_compile "$@" ;;
    link) apkbuild_cmd_link "$@" ;;
    dex) apkbuild_cmd_dex "$@" ;;
    package) apkbuild_cmd_package "$@" ;;
    sign) apkbuild_cmd_sign "$@" ;;
    apk) apkbuild_cmd_apk "$@" ;;
    aar) apkbuild_cmd_aar "$@" ;;
    *) printf 'error: unknown command %s\n\n' "$command" >&2; apkbuild_usage >&2; exit 2 ;;
esac
